---
import Layout from "../../../layouts/Layout.astro";
import Header from "../../../components/Header.astro";
import Footer from "../../../components/Footer.astro";
import PageBanner from "../../../components/PageBanner.astro";
import { Image } from "astro:assets";

import g74 from "../../../assets/images/gallery-work-74.jpg";
import g75 from "../../../assets/images/gallery-work-75.jpg";
import g76 from "../../../assets/images/gallery-work-76.jpg";
import g77 from "../../../assets/images/gallery-work-77.jpg";
import g78 from "../../../assets/images/gallery-work-78.jpg";
import g79 from "../../../assets/images/gallery-work-79.jpg";
import g80 from "../../../assets/images/gallery-work-80.jpg";
import g81 from "../../../assets/images/gallery-work-81.jpg";
import g82 from "../../../assets/images/gallery-work-82.jpg";
import g83 from "../../../assets/images/gallery-work-83.jpg";
import g84 from "../../../assets/images/gallery-work-84.jpg";
import g85 from "../../../assets/images/gallery-work-85.jpg";

const images = [
  { src: g74, alt: "Concord Tower Apartments — blast rig and boom lift staged at the high-rise facade" },
  { src: g75, alt: "Concord Tower Apartments — mobile blast equipment and building exterior" },
  { src: g76, alt: "Concord Tower Apartments — blasting the high-rise facade panels" },
  { src: g77, alt: "Concord Tower Apartments — building exterior with mobile blast rig" },
  { src: g78, alt: "Concord Tower Apartments — facade panel section prepared for blasting" },
  { src: g79, alt: "Concord Tower Apartments — upward view of high-rise facade during blast prep" },
  { src: g80, alt: "Concord Tower Apartments — boom lifts positioned on the tower facade" },
  { src: g81, alt: "Concord Tower Apartments — blast equipment staged at the building" },
  { src: g82, alt: "Concord Tower Apartments — mobile blast rig and boom lift at the high-rise" },
  { src: g83, alt: "Concord Tower Apartments — facade detail during surface preparation" },
  { src: g84, alt: "Concord Tower Apartments — high-rise facade blast prep, overcast" },
  { src: g85, alt: "Concord Tower Apartments — completed section of the facade blast prep" },
];
---

<Layout
  title="Concord Tower Apartments — High-Rise Facade Blast Prep | Blasting Jack"
  description="Mobile sandblasting of high-rise facade panels at Concord Tower Apartments — boom lift access, surface preparation for building envelope restoration by Blasting Jack."
  canonical="https://blastingjack.com/gallery/concord-tower-apartments/"
>
  <Header />
  <PageBanner
    label="Project Gallery"
    title="Concord Tower Apartments — High-Rise Facade Blast Prep"
  />

  <section class="py-16 md:py-24 bg-white">
    <div class="max-w-[1400px] mx-auto px-6">

      <div class="flex items-center gap-3 mb-10">
        <a href="/gallery/" class="text-body text-[14px] hover:text-primary transition-colors flex items-center gap-1.5">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"/></svg>
          All Projects
        </a>
        <span class="text-gray-300">/</span>
        <span class="text-[14px] text-heading font-medium">Concord Tower Apartments</span>
      </div>

      <!-- Videos -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-10">
        {[
          { src: "/videos/concord-1.mp4", label: "Concord Tower Apartments blast prep — clip 1" },
          { src: "/videos/concord-2.mp4", label: "Concord Tower Apartments blast prep — clip 2" },
          { src: "/videos/concord-3.mp4", label: "Concord Tower Apartments blast prep — clip 3" },
          { src: "/videos/concord-4.mp4", label: "Concord Tower Apartments blast prep — clip 4" },
          { src: "/videos/concord-5.mp4", label: "Concord Tower Apartments blast prep — clip 5" },
          { src: "/videos/concord-6.mp4", label: "Concord Tower Apartments blast prep — clip 6" },
          { src: "/videos/concord-7.mp4", label: "Concord Tower Apartments blast prep — clip 7" },
          { src: "/videos/concord-8.mp4", label: "Concord Tower Apartments blast prep — clip 8" },
          { src: "/videos/concord-9.mp4", label: "Concord Tower Apartments blast prep — clip 9" },
          { src: "/videos/concord-10.mp4", label: "Concord Tower Apartments blast prep — clip 10" },
        ].map((vid) => (
          <div class="rounded-lg overflow-hidden bg-black shadow-md">
            <video
              controls
              playsinline
              preload="metadata"
              class="w-full max-h-[400px] object-contain"
              aria-label={vid.label}
            >
              <source src={vid.src} type="video/mp4" />
            </video>
          </div>
        ))}
      </div>

      <!-- Photos -->
      <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-3 md:gap-4">
        {images.map((img, i) => (
          <div
            class="group relative aspect-[4/3] overflow-hidden rounded-lg cursor-pointer bg-gray-100"
            data-lightbox-trigger
            data-lightbox-index={i}
          >
            <Image
              src={img.src}
              alt={img.alt}
              width={640}
              height={480}
              class="w-full h-full object-cover transition-transform duration-500 ease-out group-hover:scale-105"
            />
            <div class="absolute inset-0 bg-black/0 group-hover:bg-black/20 transition-colors duration-300 flex items-center justify-center">
              <div class="w-10 h-10 rounded-full bg-white/90 flex items-center justify-center opacity-0 group-hover:opacity-100 transition-all duration-300 scale-75 group-hover:scale-100">
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#333" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                  <circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/>
                  <line x1="11" y1="8" x2="11" y2="14"/><line x1="8" y1="11" x2="14" y2="11"/>
                </svg>
              </div>
            </div>
          </div>
        ))}
      </div>

      <p class="text-body text-[14px] mt-5 text-center">10 videos &middot; {images.length} photos</p>
    </div>
  </section>

  <section class="py-12 md:py-16" style="background-color: #1a1a1a;">
    <div class="max-w-[1400px] mx-auto px-6 flex flex-col md:flex-row items-center justify-between gap-6">
      <h2 class="font-heading text-[28px] md:text-[44px] font-medium leading-[1.2] tracking-[-0.045em] text-white">
        Have a similar project?
      </h2>
      <a
        href="/#contact"
        class="inline-block bg-white text-black font-semibold text-[18px] px-[40px] md:px-[60px] py-[18px] md:py-[20px] border-2 border-white hover:bg-transparent hover:text-white transition-all duration-300 shrink-0"
      >
        Get a Free Estimate
      </a>
    </div>
  </section>

  <Footer />

  <div
    id="gallery-lightbox"
    class="fixed inset-0 z-[300] bg-black/92 backdrop-blur-sm items-center justify-center"
    style="display:none"
    role="dialog"
    aria-modal="true"
  >
    <button id="lb-close" class="absolute top-5 right-5 text-white/70 hover:text-white transition-colors z-10 p-2" aria-label="Close">
      <svg xmlns="http://www.w3.org/2000/svg" width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
    </button>
    <button id="lb-prev" class="absolute left-4 top-1/2 -translate-y-1/2 text-white/70 hover:text-white transition-colors z-10 p-2" aria-label="Previous">
      <svg xmlns="http://www.w3.org/2000/svg" width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"/></svg>
    </button>
    <button id="lb-next" class="absolute right-4 top-1/2 -translate-y-1/2 text-white/70 hover:text-white transition-colors z-10 p-2" aria-label="Next">
      <svg xmlns="http://www.w3.org/2000/svg" width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg>
    </button>
    <div class="w-full h-full flex items-center justify-center px-16">
      <img id="lb-img" src="" alt="" class="max-w-full max-h-[90vh] object-contain rounded-lg shadow-2xl" />
    </div>
    <div class="absolute bottom-5 left-1/2 -translate-x-1/2 text-white/50 text-[13px]" id="lb-counter"></div>
  </div>
</Layout>

<script>
  function init() {
    const lb = document.getElementById("gallery-lightbox") as HTMLElement;
    const lbImg = document.getElementById("lb-img") as HTMLImageElement;
    const lbCounter = document.getElementById("lb-counter") as HTMLElement;
    const triggers = Array.from(document.querySelectorAll("[data-lightbox-trigger]"));
    const srcs: string[] = [];
    const alts: string[] = [];

    triggers.forEach((t) => {
      const img = t.querySelector("img");
      if (img) { srcs.push(img.src); alts.push(img.alt); }
    });

    let current = 0;

    function open(i: number) {
      current = i;
      lbImg.src = srcs[i];
      lbImg.alt = alts[i];
      lbCounter.textContent = `${i + 1} / ${srcs.length}`;
      lb.style.display = "flex";
      document.body.style.overflow = "hidden";
    }
    function close() {
      lb.style.display = "none";
      document.body.style.overflow = "";
    }

    triggers.forEach((t) => {
      t.addEventListener("click", () => open(parseInt(t.getAttribute("data-lightbox-index") || "0", 10)));
    });
    document.getElementById("lb-close")?.addEventListener("click", close);
    document.getElementById("lb-prev")?.addEventListener("click", () => open((current - 1 + srcs.length) % srcs.length));
    document.getElementById("lb-next")?.addEventListener("click", () => open((current + 1) % srcs.length));
    lb?.addEventListener("click", (e) => { if (e.target === lb) close(); });
    document.addEventListener("keydown", (e) => {
      if (lb.style.display === "none") return;
      if (e.key === "Escape") close();
      if (e.key === "ArrowLeft") open((current - 1 + srcs.length) % srcs.length);
      if (e.key === "ArrowRight") open((current + 1) % srcs.length);
    });
  }

  init();
  document.addEventListener("astro:page-load", init);
</script>
